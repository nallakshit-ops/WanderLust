<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <form action="/login" method="POST" class="needs-validation" no-validate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>

                <input
                    name="username"
                    id="username"
                    placeholder="Enter username"
                    type="text"
                    class="form-control"
                    required
                >

            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>

                <input
                    name="password"
                    id="password"
                    placeholder="Enter password"
                    type="password"
                    class="form-control"
                    required
                >

            </div>

            <button class="btn btn-dark">Login</button>

        </form>
    </div>
</div>